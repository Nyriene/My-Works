import java.awt.image.BufferedImage;
import java.io.File;
import javax.imageio.ImageIO;

public class Steganography {
    
    public static void main(String[] args) {
        try {
            // Load the original image
            File inputFile = new File("input.png"); 
            BufferedImage image = ImageIO.read(inputFile);

            // Message to hide
            String secretMessage = "Thank you sir!";

            // Encode the message into the image
            BufferedImage encodedImage = encodeMessage(image, secretMessage);
            ImageIO.write(encodedImage, "png", new File("encoded.png"));
            System.out.println("Message encoded successfully!");

            // Decode the message from the image
            String decodedMessage = decodeMessage(encodedImage);
            System.out.println("Decoded message: " + decodedMessage);

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static BufferedImage encodeMessage(BufferedImage image, String message) {
        int width = image.getWidth();
        int height = image.getHeight();

        // Convert message into binary and append a delimiter
        String binaryMessage = toBinary(message) + "00000000"; // '00000000' acts as an end marker

        int messageIndex = 0;
        BufferedImage encodedImage = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int pixel = image.getRGB(x, y);

                if (messageIndex < binaryMessage.length()) {
                    int lsb = binaryMessage.charAt(messageIndex) == '1' ? 1 : 0;
                    pixel = (pixel & 0xFFFFFFFE) | lsb; 
                    messageIndex++;
                }

                encodedImage.setRGB(x, y, pixel);
            }
        }
        return encodedImage;
    }

    public static String decodeMessage(BufferedImage image) {
        int width = image.getWidth();
        int height = image.getHeight();
        StringBuilder binaryMessage = new StringBuilder();

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int pixel = image.getRGB(x, y);
                int lsb = pixel & 1; // Extract LSB
                binaryMessage.append(lsb);
                
                // Stop if we reach the delimiter "00000000"
                if (binaryMessage.length() % 8 == 0 && binaryMessage.toString().endsWith("00000000")) {
                    return fromBinary(binaryMessage.substring(0, binaryMessage.length() - 8));
                }
            }
        }
        return "";
    }

    private static String toBinary(String text) {
        StringBuilder binary = new StringBuilder();
        for (char c : text.toCharArray()) {
            binary.append(String.format("%8s", Integer.toBinaryString(c)).replace(' ', '0'));
        }
        return binary.toString();
    }

    private static String fromBinary(String binary) {
        StringBuilder text = new StringBuilder();
        for (int i = 0; i < binary.length(); i += 8) {
            text.append((char) Integer.parseInt(binary.substring(i, i + 8), 2));
        }
        return text.toString();
    }
}
